<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- Navegación autónoma de Martha: filtro del lidar + Nav2 (AMCL Omni + planner + DWB holonómico)
     + twist_mux + waypoints con nombre. Todo viene en la imagen Docker (docker/Dockerfile). -->
<package format="3">
  <name>andesrobot_navigation</name>
  <version>0.1.0</version>
  <description>Navegación autónoma (Nav2, modelo Omni) de MARTHA con waypoints con nombre.</description>
  <maintainer email="nicolas58david@hotmail.com">Mocolax</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>nav2_smoother</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>dwb_core</exec_depend>
  <exec_depend>laser_filters</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>andesrobot_gazebo</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-numpy</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
